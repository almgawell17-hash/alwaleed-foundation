{
  "expo": {
    "name": "Alwaleed Philanthropies",
    "slug": "workspace",
    "scheme": "workspace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alwaleedfoundationapp.workspace"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.alwaleedfoundationapp.workspace"
    },
    "extra": {
      "eas": {
        "projectId": "53cda298-5ad2-4e43-b0ff-e757d6eee070"
      }
    },
    "plugins": ["expo-web-browser"]
  }
}
