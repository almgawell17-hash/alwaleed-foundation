{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "lib/**",
    "artifacts/**",
    "alwaleed-humanity/**",
    "node_modules/**"
  ],
  "references": [
    {
      "path": "./lib/api-client-react"
    }
  ]
}
